# Copy to .env.local for local dev. In Vercel, add the same keys under Project → Settings → Environment Variables.

REACT_APP_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_anon_key_here

# Optional: production site origin (must match Supabase Auth URL Configuration)
# REACT_APP_SITE_URL=https://your-app.vercel.app
